             return 1;
         }
-        if (u->ctx.cont_len.has > 0)
-            (void) lsquic_stream_verify_len(stream, u->ctx.cont_len.value);
+        /* The application enforces body length with a stream-scoped error. */
     }
     else if ((qdh->qdh_flags & QDH_SERVER) &&
             /* If PRIORITY_UPDATE has been used (SMBF_HPRIO_SET), then the
@@ -658,6 +662,35 @@ qdh_maybe_destroy_hblock_ctx (struct qpack_dec_hdl *qdh,
 }
 
 
+static void
+qdh_reset_header_error_stream (struct qpack_dec_hdl *qdh,
+                                                struct lsquic_stream *stream)
+{
+    lsquic_stream_maybe_reset(stream, HEC_MESSAGE_ERROR, 1);
+}
+
+
+/* A resource shortage is stream-scoped: the request can be retried later
+ * and must not take the connection down with it.
+ */
+static void
+qdh_reset_resource_error_stream (struct qpack_dec_hdl *qdh,
+                                                struct lsquic_stream *stream)
+{
+    lsquic_stream_maybe_reset(stream, HEC_REQUEST_REJECTED, 1);
+}
+
+
+int
+lsquic_qdh_take_hsi_error (struct qpack_dec_hdl *qdh)
+{
+    const int had_error = !!(qdh->qdh_flags & (QDH_HSI_HEADER_ERROR
+                                            | QDH_HSI_RESOURCE_ERROR));
+    qdh->qdh_flags &= ~(QDH_HSI_HEADER_ERROR|QDH_HSI_RESOURCE_ERROR);
+    return had_error;
+}
+
+
 static enum lsqpack_read_header_status
 qdh_header_read_results (struct qpack_dec_hdl *qdh,
         struct lsquic_stream *stream, enum lsqpack_read_header_status rhs,
@@ -699,6 +732,8 @@ qdh_header_read_results (struct qpack_dec_hdl *qdh,
                 LSQ_DEBUG("finishing hset failed");
                 free(uh);
                 qdh->qdh_enpub->enp_hsi_if->hsi_discard_header_set(hset);
+                if (qdh->qdh_flags & QDH_HSI_HEADER_ERROR)
+                    qdh_reset_header_error_stream(qdh, stream);
                 return LQRHS_ERROR;
             }
             uh->uh_hset = hset;
@@ -727,6 +762,20 @@ qdh_header_read_results (struct qpack_dec_hdl *qdh,
     }
     else if (rhs == LQRHS_ERROR)
     {
+        if (qdh->qdh_flags & (QDH_HSI_HEADER_ERROR | QDH_HSI_RESOURCE_ERROR))
+        {
+            /* Return the in-flight header set before resetting: the reset
+             * path only discards through lsquic_qdh_cancel_stream(), which
+             * depends on SMQF_QPACK_DEC having been armed by an earlier
+             * LQRHS_NEED/LQRHS_BLOCKED and is not set for a one-shot error.
+             */
+            qdh_maybe_destroy_hblock_ctx(qdh, stream);
+            if (qdh->qdh_flags & QDH_HSI_RESOURCE_ERROR)
+                qdh_reset_resource_error_stream(qdh, stream);
+            else
+                qdh_reset_header_error_stream(qdh, stream);
+            return rhs;
+        }
         qdh_maybe_destroy_hblock_ctx(qdh, stream);
         qerr = lsqpack_dec_get_err_info(&qdh->qdh_decoder);
         QDH_ABORT_CONN_ONCE(qdh, 1,
@@ -763,6 +812,8 @@ lsquic_qdh_header_in_begin (struct qpack_dec_hdl *qdh,
     if (!u)
     {
         LSQ_INFO("cannot allocate hblock_ctx");
+        qdh->qdh_flags |= QDH_HSI_RESOURCE_ERROR;
+        qdh_reset_resource_error_stream(qdh, stream);
         return LQRHS_ERROR;
     }
 
@@ -773,6 +824,8 @@ lsquic_qdh_header_in_begin (struct qpack_dec_hdl *qdh,
     {
         free(u);
         LSQ_DEBUG("hsi_create_header_set failure");
+        qdh->qdh_flags |= QDH_HSI_RESOURCE_ERROR;
+        qdh_reset_resource_error_stream(qdh, stream);
         return LQRHS_ERROR;
     }
 
