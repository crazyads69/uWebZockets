BENCHMARK_ID=h2-tls-scaling-v1
SCHEMA_VERSION=1
BUILD_OPTIMIZE=ReleaseFast
H2LOAD_THREADS=8
H2LOAD_CONNECTIONS="64 256 512 1024 2048"
H2LOAD_STREAMS="1 8"
H2LOAD_DURATION_SECONDS=10
H2LOAD_WARMUP_SECONDS=2
H2LOAD_SAMPLES=3
H2LOAD_REQUESTS=100000000
H2LOAD_URL=https://127.0.0.1:8443/
H2LOAD_RESPONSE_BODY="hello from a TLS worker group"
TLS_MIN_VERSION=TLS1.3
